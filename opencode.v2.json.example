{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 30000,
      "catalog": 30000,
      "execution": 300000
    },
    "servers": {
      "keel": {
        "type": "local",
        "command": ["keel-pentest"],
        "environment": {
          "PYTHONUNBUFFERED": "1"
        },
        "disabled": false
      }
    }
  }
}
